# ============================================
# Shared Environment Variables
# Used by docker-compose.yml for all services
# ============================================

# Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Ports
API_GATEWAY_PORT=8080
LEARNING_SERVICE_PORT=4001
ASSESSMENT_SERVICE_PORT=4002

# ============================================
# PostgreSQL Database (Shared Instance)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=torii_db

# ============================================
# Redis Configuration
# ============================================
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TTL=3600

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_LISTENER_SIMPLE_ACKNOWLEDGE_MODE=auto
SPRING_RABBITMQ_LISTENER_SIMPLE_RETRY_ENABLED=true
SPRING_RABBITMQ_LISTENER_SIMPLE_RETRY_MAX_ATTEMPTS=3

