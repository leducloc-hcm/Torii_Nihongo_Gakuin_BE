# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================
MCP_ENABLED=true
MCP_TOOL_APPROVAL_REQUIRED=false
MCP_MAX_TOOL_EXECUTIONS=10
MCP_COURSE_SERVER_URL=https://agent.torii-nihongo-gakuin.io.vn/course/mcp
MCP_COURSE_ENABLED=true
MCP_ENROLLMENT_SERVER_URL=https://agent.torii-nihongo-gakuin.io.vn/enrollment/mcp
MCP_ENROLLMENT_ENABLED=true
MCP_FLASHCARD_SERVER_URL=https://agent.torii-nihongo-gakuin.io.vn/flashcard/mcp
MCP_FLASHCARD_ENABLED=true
MCP_BLOG_SERVER_URL=https://agent.torii-nihongo-gakuin.io.vn/blog/mcp
MCP_BLOG_ENABLED=true
MCP_ASSESSMENT_SERVER_URL=https://agent.torii-nihongo-gakuin.io.vn/assessment/mcp
MCP_ASSESSMENT_ENABLED=true
