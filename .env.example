# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE: Controls randomness (0-2)
#   Note: gpt-5-nano only supports temperature=1 (default)
#   Other models: 0.7 = balanced, 1.0 = default, higher = more creative
OPENAI_TEMPERATURE=1
OPENAI_MAX_TOKENS=0
# OPENAI_MAX_TOKENS options:
#   0 = UNLIMITED (recommended for demo/testing - no token limit)
#   > 0 = Specific limit (e.g., 4000, 8000, 16000 for cost control in production)

# MCP (Model Context Protocol) Configuration
MCP_ENABLED=true
MCP_TOOL_APPROVAL_REQUIRED=false
MCP_MAX_TOOL_EXECUTIONS=10

# Course MCP Server
MCP_COURSE_SERVER_URL=http://localhost:8000/course/mcp
MCP_COURSE_ENABLED=true

# Lesson MCP Server
MCP_LESSON_SERVER_URL=http://localhost:8000/lesson/mcp
MCP_LESSON_ENABLED=true