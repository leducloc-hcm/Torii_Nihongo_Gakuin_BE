    "framer-motion": "^12.23.24",
    "google-auth-library": "^10.3.0",
    "googleapis": "^160.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.4.1",
    "nestjs-zod": "^4.3.1",
    "otpauth": "^9.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.0.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
