{
  "info": {
    "name": "Assessment Item API - Complete Tests",
    "description": "Collection đầy đủ để test Assessment Item API với Questions và Question Groups",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Item - Multiple Questions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectionId\": 1,\n  \"questionIds\": [101, 102, 103, 104, 105],\n  \"name\": \"Basic Vocabulary Test\",\n  \"scorePerQuestion\": 1.0,\n  \"order\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment-items",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items"]
        },
        "description": "Tạo item với nhiều questions - dùng cho Vocabulary, Grammar sections"
      }
    },
    {
      "name": "2. Create Item - Question Groups",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectionId\": 3,\n  \"questionGroupIds\": [201, 202],\n  \"name\": \"Reading Comprehension\",\n  \"scorePerQuestion\": 2.0,\n  \"order\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment-items",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items"]
        },
        "description": "Tạo item với question groups - dùng cho Reading, Listening sections"
      }
    },
    {
      "name": "3. Create Item - Mixed (Questions + Groups)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sectionId\": 2,\n  \"questionIds\": [111, 112],\n  \"questionGroupIds\": [301],\n  \"name\": \"Grammar Mixed\",\n  \"order\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment-items",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items"]
        },
        "description": "Tạo item với cả questions và question groups"
      }
    },
    {
      "name": "4. Get Item by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/assessment-items/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items", "1"]
        },
        "description": "Lấy thông tin chi tiết của 1 item"
      }
    },
    {
      "name": "5. Get All Items - With Filters",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/assessment-items?page=1&limit=20&sectionId=1&sortBy=order&sortOrder=asc",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items"],
          "query": [
            {"key": "page", "value": "1"},
            {"key": "limit", "value": "20"},
            {"key": "sectionId", "value": "1"},
            {"key": "sortBy", "value": "order"},
            {"key": "sortOrder", "value": "asc"}
          ]
        },
        "description": "Lấy danh sách items với pagination và filter"
      }
    },
    {
      "name": "6. Update Item - Change Questions",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"questionIds\": [106, 107, 108, 109, 110],\n  \"name\": \"Updated Vocabulary Set\",\n  \"scorePerQuestion\": 1.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment-items/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items", "1"]
        },
        "description": "Update item - thay đổi danh sách questions"
      }
    },
    {
      "name": "7. Update Item - Change Groups",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"questionGroupIds\": [203, 204, 205]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/assessment-items/2",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items", "2"]
        },
        "description": "Update item - thay đổi danh sách question groups"
      }
    },
    {
      "name": "8. Delete Item",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/assessment-items/1",
          "host": ["{{baseUrl}}"],
          "path": ["assessment-items", "1"]
        },
        "description": "Xóa item"
      }
    },
    {
