          "body": {
            "sectionId": 2,
            "questionIds": [111, 112, 113],
            "name": "文法 Part 1 - Basic Grammar",
            "scorePerQuestion": 1.0,
            "order": 0
          }
        },
        {
          "step": 2,
          "action": "Tạo Item với grammar passage",
          "method": "POST",
          "url": "/assessment-items",
          "body": {
            "sectionId": 2,
            "questionGroupIds": [301],
            "name": "文法 Part 2 - Context Grammar",
            "scorePerQuestion": 1.5,
            "order": 1
          }
        }
      ]
    }
  },

  "sample_requests_for_postman": {
    "create_vocab_item": {
      "POST": "{{baseUrl}}/assessment-items",
      "Headers": {
        "Authorization": "Bearer {{token}}",
        "Content-Type": "application/json"
      },
      "Body": {
        "sectionId": 1,
        "questionIds": [101, 102, 103, 104, 105],
        "name": "Basic Vocabulary",
        "scorePerQuestion": 1.0,
        "order": 0
      }
    },

    "create_reading_item": {
      "POST": "{{baseUrl}}/assessment-items",
      "Headers": {
        "Authorization": "Bearer {{token}}",
        "Content-Type": "application/json"
      },
      "Body": {
        "sectionId": 3,
        "questionGroupIds": [201, 202],
        "name": "Reading Comprehension",
        "scorePerQuestion": 2.0,
        "order": 0
      }
    },

    "create_mixed_item": {
      "POST": "{{baseUrl}}/assessment-items",
      "Headers": {
        "Authorization": "Bearer {{token}}",
        "Content-Type": "application/json"
      },
      "Body": {
        "sectionId": 2,
        "questionIds": [111, 112],
        "questionGroupIds": [301],
        "name": "Grammar Mixed",
        "order": 0
      }
    },

    "get_items_by_section": {
      "GET": "{{baseUrl}}/assessment-items?sectionId=1&page=1&limit=20",
      "Headers": {
        "Authorization": "Bearer {{token}}"
      }
    },

    "update_item_questions": {
      "PUT": "{{baseUrl}}/assessment-items/1",
      "Headers": {
        "Authorization": "Bearer {{token}}",
        "Content-Type": "application/json"
      },
      "Body": {
        "questionIds": [106, 107, 108],
        "name": "Updated Vocabulary Set"
      }
    }
  },

  "common_mistakes": {
    "mistake_1": {
      "wrong": {
        "questionId": [1, 2, 3]
      },
      "correct": {
        "questionIds": [1, 2, 3]
      },
      "error": "Unknown argument `questionId`. Did you mean `questions`?",
      "solution": "Phải dùng 'questionIds' (có chữ s ở cuối)"
    },
    "mistake_2": {
      "wrong": {
        "questionGroupId": [201, 202]
      },
      "correct": {
        "questionGroupIds": [201, 202]
      },
      "error": "Unknown argument `questionGroupId`",
      "solution": "Phải dùng 'questionGroupIds' (có chữ s ở cuối)"
    },
    "mistake_3": {
      "wrong": {
        "sectionId": 1,
        "questions": [1, 2, 3]
      },
      "correct": {
        "sectionId": 1,
        "questionIds": [1, 2, 3]
      },
      "error": "Unknown argument `questions`",
      "solution": "Phải dùng 'questionIds' không phải 'questions'"
    }
  },

  "validation_rules": {
    "required_fields": [
      "sectionId"
    ],
    "optional_fields": [
      "name",
      "order",
      "scorePerQuestion",
      "questionIds",
      "questionGroupIds"
    ],
    "constraints": {
      "sectionId": "Must be a valid section ID (integer)",
      "questionIds": "Array of question IDs (integers)",
      "questionGroupIds": "Array of question group IDs (integers)",
      "order": "Integer >= 0, default = 0",
      "scorePerQuestion": "Float >= 0, optional"
    },
    "notes": [
      "Có thể tạo item chỉ với questionIds",
      "Có thể tạo item chỉ với questionGroupIds",
      "Có thể tạo item với cả questionIds VÀ questionGroupIds",
      "Có thể tạo item không có questions/groups (rỗng)"
    ]
  },

