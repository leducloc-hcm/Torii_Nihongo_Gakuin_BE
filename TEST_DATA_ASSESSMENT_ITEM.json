{
  "info": {
    "title": "Assessment Item Test Data - Postman Collection",
    "description": "Dữ liệu mẫu để test Assessment Item API với Questions và Question Groups"
  },
  
  "examples": {
    "1_create_item_with_questions": {
      "name": "Tạo Item với nhiều Questions",
      "method": "POST",
      "url": "/assessment-items",
      "body": {
        "sectionId": 4,
        "questionIds": [1, 2, 3],
        "name": "問題4：つぎのぶんしょうを　よんで、しつもんに　こたえて　ください。こたえは、１・２・３・４から一番いいものを一つ選んでください。",
        "scorePerQuestion": 1,
        "order": 0
      },
      "note": "⚠️ QUAN TRỌNG: Phải dùng 'questionIds' (có s) không phải 'questionId'"
    },

    "2_create_item_with_question_groups": {
      "name": "Tạo Item với Question Groups",
      "method": "POST",
      "url": "/assessment-items",
      "body": {
        "sectionId": 4,
        "questionGroupIds": [201, 202],
        "name": "Reading Comprehension Part",
        "scorePerQuestion": 2,
        "order": 1
      }
    },

    "3_create_item_mixed": {
      "name": "Tạo Item với CẢ Questions VÀ Question Groups",
      "method": "POST",
      "url": "/assessment-items",
      "body": {
        "sectionId": 4,
        "questionIds": [1, 2],
        "questionGroupIds": [201],
        "name": "Mixed Assessment",
        "order": 2
      }
    },

    "4_create_item_vocabulary_only": {
      "name": "Tạo Item chỉ có Vocabulary Questions",
      "method": "POST",
      "url": "/assessment-items",
      "body": {
        "sectionId": 1,
        "questionIds": [101, 102, 103, 104, 105],
        "name": "Basic Vocabulary Test",
        "scorePerQuestion": 1.0,
        "order": 0
      }
    },

    "5_get_item_by_id": {
      "name": "Lấy Item theo ID",
      "method": "GET",
      "url": "/assessment-items/1"
    },

    "6_get_all_items": {
      "name": "Lấy tất cả Items với pagination",
      "method": "GET",
      "url": "/assessment-items?page=1&limit=20&sectionId=4&sortBy=order&sortOrder=asc"
    },

    "7_update_item_change_questions": {
      "name": "Update Item - Thay đổi Questions",
      "method": "PUT",
      "url": "/assessment-items/1",
      "body": {
        "questionIds": [4, 5, 6],
        "name": "Updated Question Set"
      }
    },

    "8_update_item_change_groups": {
      "name": "Update Item - Thay đổi Question Groups",
      "method": "PUT",
      "url": "/assessment-items/2",
      "body": {
        "questionGroupIds": [203, 204]
      }
    },

    "9_delete_item": {
      "name": "Xóa Item",
      "method": "DELETE",
      "url": "/assessment-items/1"
    }
  },

