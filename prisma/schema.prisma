// JLPT Learning Platform — Prisma Schema
// Stack: NestJS + Prisma + PostgreSQL
// Generated: 2025-09-27

// ===== Generator & Datasource =====
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  name               String
  role               Role                @default(CUSTOMER)
  status             VerifyStatus        @default(UNVERIFIED)
  bio                String?
  totpSecret         String?             @db.VarChar(1000)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  lecturerProfile    LecturerProfile?
  staffProfile       StaffProfile?
  customerProfile    CustomerProfile?
  enrollments        Enrollment[]
  notes              LessonNote[]
  devices            Device[]
  refreshTokens      RefreshToken[]
  assessmentAttempts AssessmentAttempt[]
  cardProgress       CardProgress[]
  flashcardDecks     FlashcardDeck[]
  wrongTerms         WrongTerm[]

  classMembers ClassMember[]
  liveChats    LiveChatMessage[]
  liveHands    RaiseHand[]
  liveNotes    LiveNote[]
  attendances  Attendance[]
  spinPicks    SpinWheelEvent[]  @relation("SpinPickUser")

  folders   Folder[]
  resources Resource[] @relation("ResourceAuthor")
  reactions Reaction[]
  comments  Comment[]

  points      PointsLedger[]
  streak      Streak?
  redemptions RewardRedemption[]
  cart        Cart?
  orders      Order[]
  reviews     Review[]

  affiliateCodes AffiliateCode[]
  referrals      AffiliateReferral[] @relation("ReferralReferrer")

  blogs Blog[]

  aiThreads  AIThread[]
  aiMessages AIChatMessage[]

  assessmentPaper AssessmentPaper[]
  quiz            Quiz[]
  quizAttempts    QuizAttempt[]
  Class           Class[]

  Notification Notification[]

  Websocket Websocket[]

  AdminProfile        AdminProfile[]
  assignedAssessments AssessmentAssignment[] @relation("AssignedToUser")
  createdAssignments  AssessmentAssignment[] @relation("AssignedByUser")
  assessmentProgress  AssessmentProgress[]
  
  // Coupon system relations
  createdCoupons     Coupon[] @relation("CouponCreator")
  approvedCoupons    Coupon[] @relation("CouponApprover")
  rejectedCoupons    Coupon[] @relation("CouponRejector")
  purchasedCoupons   Coupon[] @relation("CouponPurchaser")
  couponRedemptions  CouponRedemption[] @relation("UserCouponRedemptions")
  couponAuditLogs    CouponAuditLog[] @relation("CouponAuditor")
}

model CustomerProfile {
  id          Int       @id @default(autoincrement())
  name        String?
  bio         String?
  location    String?
  username    String?   @unique
  avatar      String?
  coverPhoto  String?   @map("cover_photo")
  description String?
  phoneNumber String?   @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")
  website     String?
  userId      Int       @unique @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
}

model Device {
  id            Int            @id @default(autoincrement())
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userAgent     String
  ip            String
  lastActive    DateTime       @updatedAt
  createdAt     DateTime       @default(now())
  isActive      Boolean        @default(true)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  token     String   @unique @db.VarChar(1000)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model VerificationCode {
  id    Int                  @id @default(autoincrement())
  email String               @db.VarChar(500)
  code  String               @db.VarChar(50)
  type  VerificationCodeType

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, type])
  @@index([expiresAt])
}

model LecturerProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  name        String?
  bio         String?
  location    String?
  username    String?   @unique
  avatar      String?
  coverPhoto  String?   @map("cover_photo")
  description String?
  phoneNumber String?   @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")
  website     String?
  socialLinks String[]  @map("social_links")
  user        User      @relation(fields: [userId], references: [id])

  lecturerSpecialties LecturerSpecialty[]
}

model Specialty {
  id                  Int                 @id @default(autoincrement())
  name                String
  url                 String?             @unique
  description         String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  lecturerSpecialties LecturerSpecialty[]
}

model Notification {
  id            Int                  @id @default(autoincrement())
  type          NotificationType
  title         String
  message       String
  status        NotificationStatus   @default(UNREAD)
  priority      NotificationPriority @default(NORMAL)
  data          Json?
  actionUrl     String?              @map("action_url")
  userId        Int                  @map("user_id")
  relatedUserId Int?                 @map("related_user_id")
  entityId      Int?                 @map("entity_id")
  entityType    String?              @map("entity_type")
  createdAt     DateTime             @default(now()) @map("created_at")
  readAt        DateTime?            @map("read_at")
  expiresAt     DateTime?            @map("expires_at")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model Websocket {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime @default(now())
}

model LecturerSpecialty {
  lecturerId  Int
  specialtyId Int

  lecturer  LecturerProfile @relation(fields: [lecturerId], references: [id])
  specialty Specialty       @relation(fields: [specialtyId], references: [id])

  @@id([lecturerId, specialtyId])
}

model StaffProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  name        String?
  bio         String?
  location    String?
  username    String?   @unique
  avatar      String?
  coverPhoto  String?   @map("cover_photo")
  description String?
  phoneNumber String?   @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")
  website     String?
  user        User      @relation(fields: [userId], references: [id])
}

model AdminProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  name        String?
  bio         String?
  location    String?
  username    String?   @unique
  avatar      String?
  coverPhoto  String?   @map("cover_photo")
  description String?
  phoneNumber String?   @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth")
  website     String?
  user        User      @relation(fields: [userId], references: [id])
}

model Course {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  title        String
  subtitle     String?
  description  String?
  level        JLPTLevel
  courseType   CourseType   @default(VIDEO_QUIZ)
  thumbnailUrl String?
  price        Int          @default(0)
  status       CourseStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    Int
  lecturerIds  Int[]
  modules      Module[]
  enrollments  Enrollment[]
  reviews      Review[]
  orderItems   OrderItem[]
  cartItems    CartItem[]

  Class Class[]
  AICitation AICitation[]
  coupons CouponCourse[] @relation("CouponCourses")
}

model Module {
  id       Int    @id @default(autoincrement())
  courseId Int
  title    String
  order    Int    @default(0)

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
}

model Lesson {
  id          Int          @id @default(autoincrement())
  moduleId    Int
  title       String
  kind        LessonKind   @default(VIDEO)
  content     String?
  durationSec Int?
  mediaId     Int?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      LessonStatus @default(PRIVATE)
  module      Module       @relation(fields: [moduleId], references: [id])
  media       MediaAsset[]
  liveSession LiveSession?
  quiz        Quiz?
  notes       LessonNote[]
}

model MediaAsset {
  id        Int         @id @default(autoincrement())
  lessonId  Int?
  url       String
  kind      MediaKind   @default(OTHER)
  status    MediaStatus @default(UPLOADING)
  mimeType  String?
  sizeByte  Int?
  caption   String?
  meta      Json?
  createdAt DateTime    @default(now())

  lesson         Lesson?            @relation(fields: [lessonId], references: [id])
  questions      Question[]
  questionGroups QuestionGroup[]
  options        Option[]
  liveSessions   LiveSessionMedia[]
}

model Enrollment {
  id         Int        @id @default(autoincrement())
  userId     Int
  courseId   Int
  courseType CourseType
  createdAt  DateTime   @default(now())
  expiresAt  DateTime?

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model LessonNote {
  id           Int      @id @default(autoincrement())
  userId       Int
  lessonId     Int
  title        String?
  body         String
  timestampSec Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([lessonId, userId])
}

// ===== Placement Test & Question Bank =====
model PlacementBlueprint {
  id              Int               @id @default(autoincrement())
  level           JLPTLevel
  totalQuestions  Int               @default(25)
  vocabKanji      Int               @default(10)
  grammar         Int               @default(5)
  synonym         Int               @default(3)
  orderSentence   Int               @default(2)
  readingShort    Int               @default(2)
  readingMedium   Int               @default(3)
  active          Boolean           @default(true)
  assessmentPaper AssessmentPaper[]
}

model Question {
  id            Int            @id @default(autoincrement())
  type          QuestionType
  level         JLPTLevel
  difficulty    Difficulty     @default(MEDIUM)
  stem          String
  passage       String?
  mediaId       Int?
  explanation   String?
  createdAt     DateTime       @default(now())
  readingLength ReadingLength?
  media         MediaAsset?    @relation(fields: [mediaId], references: [id])

  groups QuestionGroupQuestion[]
  option Option[]

  assessmentAnswers        AssessmentAnswer[]
  assessmentItems          AssessmentItemQuestion[]
  quizItems                QuizItemQuestion[]
  quizAnswers              QuizAnswer[]
  assessmentAnswerProgress AssessmentAnswerProgress[]
}

model QuestionGroup {
  id        Int               @id @default(autoincrement())
  type      QuestionGroupType
  title     String?
  passage   String?
  mediaId   Int?
  order     Int?
  metadata  Json?
  createdAt DateTime          @default(now())

  media MediaAsset? @relation(fields: [mediaId], references: [id])

  questions       QuestionGroupQuestion[]
  assessmentItems AssessmentItemGroup[]
  quizItems       QuizItemGroup[]
}

model QuestionGroupQuestion {
  questionId Int
  groupId    Int
  order      Int?
  score      Float?
  createdAt  DateTime @default(now())

  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  group    QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([questionId, groupId])
}

model Option {
  id                       Int                        @id @default(autoincrement())
  questionId               Int
  content                  String?
  mediaId                  Int?
  isCorrect                Boolean                    @default(false)
  order                    Int                        @default(0)
  assessmentAnswers        AssessmentAnswer[]
  quizAnswers              QuizAnswer[]
  assessmentAnswerProgress AssessmentAnswerProgress[]
  image                    MediaAsset?                @relation(fields: [mediaId], references: [id])
  question                 Question                   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssessmentAssignment {
  id           Int              @id @default(autoincrement())
  assessmentId Int
  assignedById Int
  assignedToId Int?
  classId      Int?
  note         String?
  startAt      DateTime?
  dueAt        DateTime?
  maxAttempts  Int? // giới hạn số lần làm bài
  status       AssignmentStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assessment AssessmentPaper      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assignedBy User                 @relation("AssignedByUser", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedTo User?                @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  class      Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  progress   AssessmentProgress[]

  @@index([assessmentId])
  @@index([assignedById])
  @@index([assignedToId])
  @@index([classId])
}

model AssessmentProgress {
  id              Int       @id @default(autoincrement())
  assessmentId    Int
  userId          Int
  assignmentId    Int?
  startedAt       DateTime  @default(now())
  lastSavedAt     DateTime  @updatedAt
  currentSection  Int?
  currentQuestion Int?
  timeSpentSec    Int       @default(0)
  isSubmitted     Boolean   @default(false)
  completedAt     DateTime?
  remainingSec    Int?

  assessment AssessmentPaper            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment AssessmentAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  answers    AssessmentAnswerProgress[]

  @@unique([assessmentId, userId, assignmentId])
  @@index([assessmentId])
  @@index([userId])
  @@index([assignmentId])
}

model AssessmentAnswerProgress {
  id               Int      @id @default(autoincrement())
  progressId       Int
  questionId       Int
  selectedOptionId Int?
  lastUpdatedAt    DateTime @default(now())
  timeSpentSec     Int      @default(0)
  isFlagged        Boolean  @default(false)

  progress       AssessmentProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?            @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([progressId, questionId])
  @@index([progressId])
  @@index([questionId])
}

model AssessmentPaper {
  id         Int            @id @default(autoincrement())
  title      String
  level      JLPTLevel
  type       AssessmentType
  visibility Visibility     @default(PRIVATE)

  createdBy Int
  author    User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  scoreProfileId    Int?
  scoreProfile      ScoreProfile?       @relation(fields: [scoreProfileId], references: [id])
  blueprintId       Int? // thay cho TestPaper.blueprintId
  blueprint         PlacementBlueprint? @relation(fields: [blueprintId], references: [id])
  blueprintSnapshot Json?
  seed              BigInt?
  version           Int                 @default(1)
  generatorVersion  String?
  generatorMeta     Json?

  sections    AssessmentSection[]
  attempts    AssessmentAttempt[]
  assignments AssessmentAssignment[]
  progress    AssessmentProgress[]
}

model AssessmentSection {
  id           Int                   @id @default(autoincrement())
  assessmentId Int
  title        String
  timeLimitSec Int?
  type         AssessmentSectionType

  assessment AssessmentPaper  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  items      AssessmentItem[]
}

model AssessmentItem {
  id               Int     @id @default(autoincrement())
  sectionId        Int
  name             String?
  scorePerQuestion Float?
  order            Int     @default(0)

  section        AssessmentSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  questions      AssessmentItemQuestion[]
  questionGroups AssessmentItemGroup[]
}

model AssessmentItemQuestion {
  itemId     Int
  questionId Int
  order      Int?
  score      Float?
  createdAt  DateTime @default(now())

  item     AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([itemId, questionId])
}

model AssessmentItemGroup {
  itemId    Int
  groupId   Int
  order     Int?
  score     Float?
  createdAt DateTime @default(now())

  item  AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group QuestionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
}

model AssessmentAttempt {
  id              Int        @id @default(autoincrement())
  assessmentId    Int
  userId          Int
  startedAt       DateTime   @default(now())
  submittedAt     DateTime?
  score           Float?
  levelSuggestion JLPTLevel?
  earnedScore     Float?

  assessment AssessmentPaper    @relation(fields: [assessmentId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  answers    AssessmentAnswer[]
}

model AssessmentAnswer {
  id               Int      @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?
  isCorrect        Boolean?
  timeSpentSec     Int?
  explanation      String?

  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question          @relation(fields: [questionId], references: [id])
  selectedOption Option?           @relation(fields: [selectedOptionId], references: [id])
}

model ScoreProfile {
  id           Int        @id @default(autoincrement())
  name         String
  level        JLPTLevel?
  maxTotal     Int?
  minTotalPass Int?

  papers    AssessmentPaper[]
  sections  ScoreProfileSection[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model ScoreProfileSection {
  id             Int                   @id @default(autoincrement())
  type           AssessmentSectionType
  title          String
  maxScore       Int
  weight         Float?
  minPass        Int?
  defaultTimeSec Int?

  profileId Int
  profile   ScoreProfile @relation(fields: [profileId], references: [id])
}

model Quiz {
  id           Int      @id @default(autoincrement())
  lessonId     Int?     @unique
  title        String
  createdAt    DateTime @default(now())
  createdBy    Int
  timeLimitSec Int

  author   User          @relation(fields: [createdBy], references: [id])
  lesson   Lesson?       @relation(fields: [lessonId], references: [id])
  items    QuizItem[]
  attempts QuizAttempt[]
}

model QuizItem {
  id     Int @id @default(autoincrement())
  quizId Int
  order  Int @default(0)

  quiz           Quiz               @relation(fields: [quizId], references: [id])
  questions      QuizItemQuestion[]
  questionGroups QuizItemGroup[]
}

model QuizItemQuestion {
  itemId     Int
  questionId Int
  order      Int?
  createdAt  DateTime @default(now())

  item     QuizItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([itemId, questionId])
}

model QuizItemGroup {
  itemId  Int
  groupId Int
  order   Int?

  createdAt DateTime @default(now())

  item  QuizItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group QuestionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
}

model QuizAttempt {
  id     Int @id @default(autoincrement())
  quizId Int
  userId Int

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float? // Accuracy percentage (0-100)

  quiz    Quiz         @relation(fields: [quizId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  answers QuizAnswer[]
}

model QuizAnswer {
  id               Int      @id @default(autoincrement())
  attemptId        Int
  questionId       Int
  selectedOptionId Int?
  isCorrect        Boolean?
  explanation      String?

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id])
  question       Question    @relation(fields: [questionId], references: [id])
  selectedOption Option?     @relation(fields: [selectedOptionId], references: [id])
}

// ===== Live Classes (WebRTC 2D/3D) =====
model Class {
  id          Int      @id @default(autoincrement())
  courseId    Int?
  title       String
  description String?
  lecturerId  Int
  capacity    Int      @default(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  course               Course?                @relation(fields: [courseId], references: [id])
  lecturer             User                   @relation(fields: [lecturerId], references: [id])
  sessions             LiveSession[]
  members              ClassMember[]
  orderItems           OrderItem[]
  AssessmentAssignment AssessmentAssignment[]
  CartItem             CartItem[]
}

model ClassMember {
  id       Int      @id @default(autoincrement())
  classId  Int
  userId   Int
  role     Role
  joinedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([classId, userId])
}

model LiveSession {
  id           Int       @id @default(autoincrement())
  classId      Int
  lessonId     Int?      @unique
  title        String
  scheduledAt  DateTime
  endedAt      DateTime?
  mode         LiveMode  @default(MODE2D)
  roomKey      String    @unique
  janusRoomId  Int?
  recordingUrl String?

  class      Class             @relation(fields: [classId], references: [id])
  lesson     Lesson?           @relation(fields: [lessonId], references: [id])
  pings      ResourcePing[]
  chats      LiveChatMessage[]
  hands      RaiseHand[]
  attendance Attendance[]
  spins      SpinWheelEvent[]
  notes      LiveNote[]

  mediaAssets LiveSessionMedia[]
}

model LiveSessionMedia {
  liveSessionId Int
  mediaAssetId  Int

  liveSession LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  mediaAsset  MediaAsset  @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([liveSessionId, mediaAssetId])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  sessionId Int
  userId    Int
  status    AttendanceStatus @default(PRESENT)
  joinedAt  DateTime         @default(now())
  leftAt    DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model LiveChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId Int
  userId    Int
  content   String
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
}

model RaiseHand {
  id        Int      @id @default(autoincrement())
  sessionId Int
  userId    Int
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
}

model ResourcePing {
  id        Int      @id @default(autoincrement())
  sessionId Int
  title     String
  url       String
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
}

model SpinWheelEvent {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  seed         String
  pickedUserId Int?
  createdAt    DateTime @default(now())

  session    LiveSession @relation(fields: [sessionId], references: [id])
  pickedUser User?       @relation("SpinPickUser", fields: [pickedUserId], references: [id])
}

model LiveNote {
  id        Int      @id @default(autoincrement())
  sessionId Int
  userId    Int
  title     String?
  body      String
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])
}

// ===== Flashcards & Spaced Repetition =====
model FlashcardDeck {
  id         Int        @id @default(autoincrement())
  ownerId    Int
  title      String
  level      JLPTLevel?
  visibility Visibility @default(PRIVATE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner User        @relation(fields: [ownerId], references: [id])
  cards Flashcard[]
}

model Flashcard {
  id        Int      @id @default(autoincrement())
  deckId    Int
  front     String
  back      String
  examples  String?
  hints     String?
  tags      String[]
  aiMeta    Json?
  createdAt DateTime @default(now())

  deck       FlashcardDeck  @relation(fields: [deckId], references: [id])
  progresses CardProgress[]
}

model CardProgress {
  id          Int      @id @default(autoincrement())
  userId      Int
  cardId      Int
  ef          Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)
  dueAt       DateTime @default(now())
  lastGrade   Int?

  user User      @relation(fields: [userId], references: [id])
  card Flashcard @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}

model WrongTerm {
  id       Int        @id @default(autoincrement())
  userId   Int
  term     String
  level    JLPTLevel?
  count    Int        @default(1)
  lastSeen DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, term])
}

// ===== Community Library & Folders =====
model Folder {
  id       Int    @id @default(autoincrement())
  ownerId  Int
  name     String
  parentId Int?

  owner     User       @relation(fields: [ownerId], references: [id])
  parent    Folder?    @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[]   @relation("FolderToFolder")
  resources Resource[]
}

model Resource {
  id         Int        @id @default(autoincrement())
  ownerId    Int
  folderId   Int?
  title      String
  body       String?
  mediaUrl   String?
  visibility Visibility @default(PRIVATE)
  tags       String[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  owner     User       @relation("ResourceAuthor", fields: [ownerId], references: [id])
  folder    Folder?    @relation(fields: [folderId], references: [id])
  reactions Reaction[]
  comments  Comment[]
}

model Reaction {
  id         Int          @id @default(autoincrement())
  resourceId Int
  userId     Int
  kind       ReactionKind
  createdAt  DateTime     @default(now())

  resource Resource @relation(fields: [resourceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([resourceId, userId])
}

model Comment {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     Int
  body       String
  createdAt  DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// ===== Gamification (Points, Streaks, Rewards) =====
model PointsLedger {
  id        Int      @id @default(autoincrement())
  userId    Int
  delta     Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Streak {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  startDate DateTime
  lastDate  DateTime
  longest   Int      @default(0)
  current   Int      @default(0)

  user User @relation(fields: [userId], references: [id])
}

model Reward {
  id          Int                @id @default(autoincrement())
  type        RewardType
  name        String
  points      Int                @default(0)
  stock       Int?
  redemptions RewardRedemption[]
}

model RewardRedemption {
  id        Int      @id @default(autoincrement())
  userId    Int
  rewardId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])
}

// ===== Commerce, Cart, Orders, Coupons, Affiliates =====
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id       Int  @id @default(autoincrement())
  cartId   Int
  courseId Int
  classId  Int?

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])
  class  Class? @relation(fields: [classId], references: [id])

  @@unique([cartId, courseId])
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  totalAmount   Int
  status        PaymentStatus @default(PENDING)
  providerRef   String?
  createdAt     DateTime      @default(now())
  affiliateCode String?
  
  // Coupon support
  couponId Int?

  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]
  coupon Coupon? @relation("OrderCoupon", fields: [couponId], references: [id])
  redemption CouponRedemption? @relation("OrderRedemption")
}

model OrderItem {
  id        Int           @id @default(autoincrement())
  orderId   Int
  type      OrderItemType
  courseId  Int?
  classId   Int?
  unitPrice Int
  order     Order         @relation(fields: [orderId], references: [id])
  course    Course?       @relation(fields: [courseId], references: [id])
  class     Class?        @relation(fields: [classId], references: [id])
}

model Promotion {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  kind        PromoKind @default(COUPON)
  title       String
  description String?
  discountPct Int?
  discountAmt Int?
  maxUsage    Int?
  used        Int       @default(0)
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
}

// ===== Enhanced Coupon System =====
model Coupon {
  id                 Int           @id @default(autoincrement())
  code               String        @unique
  title              String
  description        String?
  type               CouponType
  discountType       DiscountType?
  discountValue      Int?          // percentage (1-100) or fixed amount in cents
  
  // Eligibility & Constraints  
  minOrderAmount     Int?          // minimum order amount in cents
  maxDiscountAmount  Int?          // maximum discount cap in cents
  maxRedemptions     Int?          // global usage limit
  perUserLimit       Int?          // per-user usage limit
  newUsersOnly       Boolean       @default(false)
  requireFullCombo   Boolean       @default(false) // for DISCOUNT_MULTI
  
  // Time window
  startsAt           DateTime?
  endsAt             DateTime?
  
  // Status & Workflow
  status             CouponStatus  @default(DRAFT)
  
  // Audit
  createdBy          Int
  approvedBy         Int?
  rejectedBy         Int?
  approvalNote       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  // Gift coupon specific
  giftMessage        String?
  extendDays         Int?          @default(30) // days to extend existing video courses
  
  // Gift Purchase Support
  purchasedBy        Int?          // userId who purchased this gift coupon
  purchaseOrderId    Int?          // order that created this gift coupon
  recipientEmail     String?       // email of intended recipient
  recipientName      String?       // name of intended recipient
  purchasedAt        DateTime?     // when the gift was purchased
  isGiftPurchase     Boolean       @default(false) // flag to differentiate purchased gifts
  
  creator            User          @relation("CouponCreator", fields: [createdBy], references: [id])
  approver           User?         @relation("CouponApprover", fields: [approvedBy], references: [id])
  rejector           User?         @relation("CouponRejector", fields: [rejectedBy], references: [id])
  purchaser          User?         @relation("CouponPurchaser", fields: [purchasedBy], references: [id])
  
  courses            CouponCourse[]
  redemptions        CouponRedemption[]
  auditLogs          CouponAuditLog[]
  orders             Order[]       @relation("OrderCoupon")

  @@index([code])
  @@index([status])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([purchasedBy])
  @@index([isGiftPurchase])
}

model CouponCourse {
  id        Int    @id @default(autoincrement())
  couponId  Int
  courseId  Int
  required  Boolean @default(true) // for combo logic
  
  coupon    Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  course    Course @relation("CouponCourses", fields: [courseId], references: [id])
  
  @@unique([couponId, courseId])
}

model CouponRedemption {
  id           Int                @id @default(autoincrement())
  couponId     Int
  userId       Int
  orderId      Int?               @unique // for discount coupons
  discountApplied Int?            // amount discounted in cents
  
  // Gift redemption specific
  giftedCourses Json?             // array of {courseId, action: 'enrolled'|'extended'}
  pendingClassSelections Int[]    // courseIds waiting for class selection
  
  status       RedemptionStatus   @default(COMPLETED)
  redeemedAt   DateTime           @default(now())
  completedAt  DateTime?          // when all actions are done (including class selections)
  
  coupon       Coupon             @relation(fields: [couponId], references: [id])
  user         User               @relation("UserCouponRedemptions", fields: [userId], references: [id])
  order        Order?             @relation("OrderRedemption", fields: [orderId], references: [id])
  
  @@unique([couponId, userId]) // one redemption per user per coupon
  @@index([userId])
  @@index([couponId])
}

model CouponAuditLog {
  id        Int                @id @default(autoincrement())
  couponId  Int
  userId    Int                // who made the change
  action    CouponAuditAction
  oldValues Json?
  newValues Json?
  note      String?
  createdAt DateTime           @default(now())
  
  coupon    Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User               @relation("CouponAuditor", fields: [userId], references: [id])
  
  @@index([couponId])
  @@index([userId])
}

model AffiliateCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  ownerId   Int
  ratePct   Int      @default(10)
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
}

model AffiliateReferral {
  id           Int      @id @default(autoincrement())
  referrerId   Int
  refereeEmail String
  createdAt    DateTime @default(now())

  referrer User @relation("ReferralReferrer", fields: [referrerId], references: [id])
}

// ===== Ratings & Reviews, Blog, Ads =====
model Review {
  id        Int      @id @default(autoincrement())
  courseId  Int
  userId    Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([courseId, userId])
}

model Blog {
  id       Int       @id @default(autoincrement())
  title    String
  content  String
  image    String?
  slug     String    @unique
  date     DateTime  @default(now())
  authorId Int       @map("author_id")
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags     BlogTag[]
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  slug        String    @unique
  blogs       BlogTag[]
}

model BlogTag {
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@id([blogId, tagId])
}

model AdSlot {
  id     Int     @id @default(autoincrement())
  key    String  @unique
  active Boolean @default(true)

  creatives AdCreative[]
}

model AdCreative {
  id        Int       @id @default(autoincrement())
  slotId    Int
  title     String
  imageUrl  String?
  targetUrl String
  startsAt  DateTime?
  endsAt    DateTime?

  slot AdSlot @relation(fields: [slotId], references: [id])
}

// ===== AI “Sensei” (Chat + Voice) =====
model AIThread {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String?
  createdAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id])
  messages AIChatMessage[]
}

model AIChatMessage {
  id        Int      @id @default(autoincrement())
  threadId  Int
  userId    Int
  role      ChatRole
  content   String
  audioUrl  String?
  createdAt DateTime @default(now())

  thread    AIThread     @relation(fields: [threadId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  citations AICitation[]
}

model AICitation {
  id         Int     @id @default(autoincrement())
  messageId  Int
  sourceUrl  String?
  resourceId Int?

  message  AIChatMessage @relation(fields: [messageId], references: [id])
  course   Course?       @relation(fields: [resourceId], references: [id])
}

