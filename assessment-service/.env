# ============================================
# Assessment Service Environment Variables
# Spring Boot Application Configuration
# ============================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=4002

# ============================================
# Database Configuration
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?currentSchema=assessment
SPRING_DATASOURCE_USERNAME=postgres.rkizlomnljifkbdimrup
SPRING_DATASOURCE_PASSWORD=nhatngutorii
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ============================================
# JPA/Hibernate Configuration
# ============================================
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=assessment
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ============================================
# Flyway Configuration
# ============================================
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_SCHEMAS=assessment
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ============================================
# Redis Configuration
# ============================================
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_USERNAME=
SPRING_REDIS_PASSWORD=
SPRING_REDIS_DB=0
SPRING_REDIS_TIMEOUT=2000

# ============================================
# RabbitMQ Configuration
# ============================================
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=admin
SPRING_RABBITMQ_VIRTUAL_HOST=/
SPRING_RABBITMQ_LISTENER_SIMPLE_ACKNOWLEDGE_MODE=auto
SPRING_RABBITMQ_LISTENER_SIMPLE_RETRY_ENABLED=true
SPRING_RABBITMQ_LISTENER_SIMPLE_RETRY_MAX_ATTEMPTS=3
